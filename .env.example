# local — включает GET /api/debug/bitrix/deal/{id}. На хостинге: production.
APP_ENV=production
LOG_LEVEL=info
# LOG_PATH=/абсолютный/путь/app.log
# LOCK_DIR=/абсолютный/путь/locks

# Входящий вебхук Bitrix24 (права: crm, im). Только здесь, не в коде.
BITRIX_WEBHOOK_URL=

# Токен для POST /api/bitrix/check-product (робот / ручной вызов) и ?token= у события.
BITRIX_CALLBACK_TOKEN=
# application_token из настроек исходящего вебхука ONCRMDEALUPDATE.
BITRIX_EVENT_APPLICATION_TOKEN=

BITRIX_KASPI_PRODUCT_FIELD=UF_CRM_XXXXXXXX
BITRIX_PRODUCTS_HASH_FIELD=UF_CRM_XXXXXXXX
BITRIX_PRODUCT_CHECK_STATUS_FIELD=UF_CRM_XXXXXXXX

BITRIX_VALUE_MATCH=OK
BITRIX_VALUE_MISMATCH=ERROR
BITRIX_VALUE_NOT_ATTACHED=ERROR

BITRIX_COMMENT_EMOJI=true
BITRIX_NOTIFY_ENABLED=true
BITRIX_NOTIFY_TIMELINE=true
BITRIX_NOTIFY_ASSIGNED=true
# ID пользователей через запятую, например 1,9
BITRIX_NOTIFY_USER_IDS=

BITRIX_HTTP_TIMEOUT=15
BITRIX_HTTP_RETRY_TIMES=3
BITRIX_HTTP_RETRY_SLEEP_MS=500
